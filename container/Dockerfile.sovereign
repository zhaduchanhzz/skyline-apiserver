# syntax=docker/dockerfile:1

# Build the API and the customized console into one Skyline image.
ARG VENV_TAG=3.12-latest
FROM ghcr.io/rackerlabs/genestack-images/openstack-venv:${VENV_TAG} AS dependency_build

ARG OS_CONSTRAINTS=stable/2025.1
ARG APISERVER_REPO=https://github.com/zhaduchanhzz/skyline-apiserver.git
ARG APISERVER_REF=52e4a981751e2d561908871b4c996807cd5c557e
ARG CONSOLE_REPO=https://github.com/zhaduchanhzz/skyline-console.git
ARG CONSOLE_REF=20670732f7e1a92b549aa251b9115bb31b450eae

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
      gcc make git wget curl \
    && rm -rf /var/lib/apt/lists/*

RUN git clone "${APISERVER_REPO}" /opt/skyline-apiserver \
    && git -C /opt/skyline-apiserver checkout --detach "${APISERVER_REF}" \
    && test "$(git -C /opt/skyline-apiserver rev-parse HEAD)" = "${APISERVER_REF}" \
    && git clone --depth 1 "${CONSOLE_REPO}" /opt/skyline-console \
    && test "$(git -C /opt/skyline-console rev-parse HEAD)" = "${CONSOLE_REF}" \
    && test -s /opt/skyline-console/skyline_console/static/index.html \
    && test -s /opt/skyline-console/skyline_console/static/main.js

# skyline-nginx-generator imports skyline_console.static_path. Installing the
# Python package keeps that path and its compiled assets together.
RUN /var/lib/openstack/bin/pip install -U /opt/skyline-console \
    && /var/lib/openstack/bin/pip install \
      -r /opt/skyline-apiserver/requirements.txt \
      -c "https://raw.githubusercontent.com/openstack/requirements/${OS_CONSTRAINTS}/upper-constraints.txt" \
    && /var/lib/openstack/bin/pip install -U /opt/skyline-apiserver \
      -c "https://raw.githubusercontent.com/openstack/requirements/${OS_CONSTRAINTS}/upper-constraints.txt" \
    && /var/lib/openstack/bin/python -c \
      "from skyline_console import static_path; from skyline_apiserver.main import app; assert (static_path / 'index.html').is_file(); assert (static_path / 'main.js').is_file(); assert app.title"

FROM python:3.12-slim-bookworm

RUN apt-get update \
    && apt-get install --no-install-recommends -y nginx \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 42424 skyline \
    && useradd --system --gid 42424 --uid 42424 \
      --shell /usr/sbin/nologin --create-home --home /var/lib/skyline skyline \
    && mkdir -p /var/lib/openstack/etc/skyline /var/log/skyline \
    && ln -s /var/lib/openstack/etc/skyline /etc/skyline

COPY --from=dependency_build /var/lib/openstack /var/lib/openstack
COPY --from=dependency_build /opt/skyline-apiserver /opt/skyline-apiserver
COPY --from=dependency_build /opt/skyline-apiserver/etc/gunicorn.py /etc/skyline/gunicorn.py
COPY container/start_sovereign.sh /usr/local/bin/start_sovereign.sh

RUN chmod +x /usr/local/bin/start_sovereign.sh \
    && chown -R skyline:skyline /var/lib/skyline /var/log/skyline /var/lib/openstack/etc/skyline \
    && /var/lib/openstack/bin/python -c \
      "from skyline_console import static_path; from skyline_apiserver.main import app; assert (static_path / 'index.html').is_file(); assert (static_path / 'main.js').is_file(); assert app.title"

ENV PATH="/var/lib/openstack/bin:${PATH}"
WORKDIR /opt/skyline-apiserver
EXPOSE 9999

ENTRYPOINT ["/usr/local/bin/start_sovereign.sh"]
