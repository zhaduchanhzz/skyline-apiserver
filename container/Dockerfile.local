FROM python:3.10-slim

WORKDIR /app

COPY requirements.txt /tmp/skyline-requirements.txt
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libffi-dev \
    && python -m pip install --no-cache-dir -r /tmp/skyline-requirements.txt \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/skyline-requirements.txt

ENV OS_CONFIG_DIR=/app/etc \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

CMD ["uvicorn", "skyline_apiserver.main:app", "--host", "0.0.0.0", "--port", "28000", "--reload", "--reload-dir", "skyline_apiserver"]
